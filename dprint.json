{
  "lineWidth": 100,
  "typescript": {
    "deno": true,
    "lineWidth": 100
  },
  "json": {
    "deno": true,
    "lineWidth": 100
  },
  "markdown": {
    "textWrap": "always",
    "list.unorderedMarker": "asterisks"
  },
  "excludes": [
    "**/*.html",
    "icons/*.svg"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.99.2",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-malva@0.16.0"
  ]
}
